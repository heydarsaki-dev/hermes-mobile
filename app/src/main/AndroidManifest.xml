<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- زنده نگه داشتن سرور هرمس وقتی اپ در پس‌زمینه است. بدون این، اندروید
         بعد از چند دقیقه پروسهٔ اپ را کشت می‌کند و چون سرور فرزندِ همان پروسه
         است، دستورات در حال اجرا نصفه می‌مانند. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.HermesMobile">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- سرویس پیش‌زمینه‌ای که سرور هرمس را زنده نگه می‌دارد.
             نوعی (foregroundServiceType) declare نمی‌کنیم: targetSdk هنوز ۲۸
             است و تعیین نکردنِ نوع یعنی اندروید محدودیت‌های زمانیِ نوع‌های
             خاص (مثلاً سقف ۶ ساعت برای dataSync در Android 15+) را اعمال
             نمی‌کند. -->
        <service
            android:name=".core.runtime.HermesService"
            android:exported="false"/>
    </application>
</manifest>
